DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY="sk-ant-..."

# API authentication secret — protects POST endpoints from unauthorized use
# Generate one: openssl rand -hex 32
EVELYN_API_SECRET="your-secret-here"
NEXT_PUBLIC_API_SECRET="your-secret-here"

# Turso (for production deployment — leave empty for local SQLite)
# Sign up at https://turso.tech, create a database, then fill these in:
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"
